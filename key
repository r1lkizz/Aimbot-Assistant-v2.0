-- ─── 2. Очистка GUI ключа ──────────────────────────────────────────────────
local function cleanupKeySystem()
    if mouseConn then
        pcall(function() mouseConn:Disconnect() end)
        mouseConn = nil
    end
    pcall(function() keyGui:Destroy() end)
end

-- ─── 3. Загрузка главного скрипта ──────────────────────────────────────────
local function grantAccess()
    if alreadyGranted then return end
    alreadyGranted = true

    statusLbl.Text = "Status: ✅ Access Granted"
    statusLbl.TextColor3 = Color3.fromRGB(60, 220, 80)

    task.spawn(function()
        task.wait(0.3)
        cleanupKeySystem()
        task.wait(0.1)

        local ok, err = pcall(function()
            local scriptContent = game:HttpGet(MAIN_SCRIPT_URL, true)
            if scriptContent and not scriptContent:match("404: Not Found") then
                local func = loadstring(scriptContent)
                if func then
                    func()
                else
                    error("loadstring returned nil")
                end
            else
                error("URL returned 404")
            end
        end)

        if not ok then
            alreadyGranted = false
            warn("[KEY] Failed to load main script: " .. tostring(err))
        end
    end)
end

-- ─── 4. Проверка ключа ─────────────────────────────────────────────────────
local function tryVerify(rawKey)
    if alreadyGranted then return end
    local key = trim(rawKey)
    if key == "" then return end
    local ver = KEY_REGISTRY[key]
    if ver == CURRENT_VERSION then
        grantAccess()
    elseif ver and ver < CURRENT_VERSION then
        statusLbl.Text = "Status: ⏰ Key expired"
        statusLbl.TextColor3 = Color3.fromRGB(255, 100, 100)
    else
        statusLbl.Text = "Status: ❌ Invalid key"
        statusLbl.TextColor3 = Color3.fromRGB(255, 100, 100)
    end
end

activateBtn.MouseButton1Click:Connect(function() tryVerify(inputBox.Text) end)
inputBox.FocusLost:Connect(function(enterPressed) if enterPressed then tryVerify(inputBox.Text) end end)

